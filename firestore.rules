rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン中のユーザーがオーナー（メール確認済み）かどうかを判定
    function isOwner() {
      return request.auth != null &&
             request.auth.token.email == "t104711202@gmail.com" &&
             request.auth.token.email_verified == true;
    }

    // 株シナリオ: オーナーのみ閲覧・変更可能
    match /stock_scenarios/{scenarioId} {
      allow read, write: if isOwner();
    }

    // アプリ通知用FCMトークン: オーナーのみ登録・管理可能
    match /fcm_tokens/{tokenId} {
      allow read, write: if isOwner();
    }

    // 筋トレメニュー: オーナーのみ閲覧・変更可能
    match /workout_menus/{menuId} {
      allow read, write: if isOwner();
    }

    // 筋トレ実績ログ: オーナーのみ閲覧・記録可能
    match /workout_logs/{logId} {
      allow read, write: if isOwner();
    }

    // くすり (お薬・サプリ管理): オーナーのみ閲覧・管理可能
    match /medications/{medId} {
      allow read, write: if isOwner();
    }

    // きろく (経過日数・定期タスク履歴): オーナーのみ閲覧・管理可能
    match /tracked_events/{eventId} {
      allow read, write: if isOwner();
    }

    // Gemini API 月間利用コスト集計: オーナーのみ閲覧・記録可能
    match /gemini_usage/{monthId} {
      allow read, write: if isOwner();
    }

    // 株ナレッジ・図解メモ: オーナーのみ閲覧・登録・編集可能
    match /stock_knowledge/{knowledgeId} {
      allow read, write: if isOwner();
    }

    // 上記以外のすべてのドキュメントへのアクセスを明示的に拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
